<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>QuoteBoard</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500&family=Barlow+Condensed:wght@500;600&display=swap" rel="stylesheet" />
  <style>
    :root {
      --wall: #dcddd8;
      --ink: #23261f;
      --muted: #5f6359;
      --felt: #1f3b33;
      --groove: #18302a;
      --letter: #f2f0eb;
      --mustard: #e0a526;
      --oak: #b5854b;
      --oak-dark: #8a6134;
      --row: 1.75rem; /* one groove = one line of letters */
      --display: "Barlow Condensed", "Arial Narrow", "Helvetica Neue", Arial, sans-serif;
      --body: "Barlow", "Helvetica Neue", Arial, sans-serif;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      min-height: 100vh;
      background: var(--wall);
      color: var(--ink);
      font-family: var(--body);
      font-size: 1rem;
      line-height: 1.5;
    }

    main {
      max-width: 44rem;
      margin: 0 auto;
      padding: 3rem 1.25rem 4rem;
    }

    /* ---------- Form ---------- */

    form {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: .75rem;
      margin-bottom: 2.5rem;
    }

    form textarea { grid-column: 1 / -1; }

    input,
    textarea {
      font: inherit;
      color: var(--ink);
      background: #f7f7f4;
      border: 1px solid #b9bbb3;
      border-radius: 4px;
      padding: .7rem .85rem;
    }

    textarea {
      min-height: 5.5rem;
      resize: vertical;
    }

    input::placeholder,
    textarea::placeholder { color: var(--muted); }

    button {
      font-family: var(--display);
      font-weight: 600;
      font-size: 1.15rem;
      letter-spacing: .04em;
      color: var(--ink);
      background: var(--mustard);
      border: 0;
      border-radius: 4px;
      padding: .6rem 1.4rem;
      cursor: pointer;
    }

    button:hover { background: #eab43d; }
    button:active { transform: translateY(1px); }

    input:focus-visible,
    textarea:focus-visible,
    button:focus-visible {
      outline: 3px solid var(--felt);
      outline-offset: 2px;
    }

    /* ---------- Letterboard ---------- */

    .board {
      background-color: var(--felt);
      /* horizontal grooves, one per line of text */
      background-image: repeating-linear-gradient(
        to bottom,
        transparent 0,
        transparent calc(var(--row) - 2px),
        var(--groove) calc(var(--row) - 2px),
        var(--groove) var(--row)
      );
      background-position: 0 var(--row);
      border: 14px solid var(--oak);
      border-image: linear-gradient(135deg, var(--oak), var(--oak-dark)) 1;
      box-shadow:
        inset 0 0 18px rgba(0, 0, 0, .45),
        0 14px 30px -12px rgba(35, 38, 31, .55);
      padding: var(--row) 1.5rem calc(var(--row) * 2);
      color: var(--letter);
      font-family: var(--display);
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: .08em;
      line-height: var(--row);
    }

    h1 {
      margin: 0 0 calc(var(--row) * 2);
      font-size: 2.1rem;
      font-weight: 600;
      line-height: calc(var(--row) * 2);
      letter-spacing: .2em;
      text-align: center;
    }

    .quote {
      margin: 0 0 calc(var(--row) * 2);
      font-size: 1.3rem;
    }

    .quote:last-child { margin-bottom: 0; }

    .quote-text { margin: 0; }

    .quote-author {
      margin: 0;
      color: var(--mustard);
      font-size: 1rem;
    }

    .empty {
      margin: 0;
      text-align: center;
      font-size: 1.15rem;
      opacity: .85;
    }

    @media (max-width: 480px) {
      form { grid-template-columns: 1fr; }
      .board { padding-left: 1rem; padding-right: 1rem; border-width: 10px; }
      h1 { font-size: 1.7rem; letter-spacing: .14em; }
      .quote { font-size: 1.1rem; }
    }

    @media (prefers-reduced-motion: reduce) {
      button:active { transform: none; }
    }
  </style>
</head>

<body>
  <main>
    <form method="post" action="/quotes">
      <textarea name="text" placeholder="Write a quote…" required></textarea>
      <input name="author" placeholder="Author (optional)" />
      <button type="submit">Add quote</button>
    </form>

    <section class="board" aria-labelledby="board-title">
      <h1 id="board-title">QuoteBoard</h1>

      {{#if quotes.length}}
      {{#each quotes}}
      <figure class="quote">
        <blockquote class="quote-text">{{this.text}}</blockquote>
        <figcaption class="quote-author">— {{this.author}}</figcaption>
      </figure>
      {{/each}}
      {{else}}
      <p class="empty">No quotes yet. Add the first one.</p>
      {{/if}}
    </section>
  </main>
</body>

</html>


